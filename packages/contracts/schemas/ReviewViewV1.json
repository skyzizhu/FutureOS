{
  "$defs": {
    "CriticReportV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "critic_run_id": {
          "format": "uuid",
          "title": "Critic Run Id",
          "type": "string"
        },
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "draft_hash": {
          "title": "Draft Hash",
          "type": "string"
        },
        "independent_input_hash": {
          "title": "Independent Input Hash",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReviewFindingV1"
          },
          "title": "Findings",
          "type": "array"
        },
        "checkers_completed": {
          "items": {
            "type": "string"
          },
          "title": "Checkers Completed",
          "type": "array"
        },
        "rules_version": {
          "const": "m3-critic-v1",
          "default": "m3-critic-v1",
          "title": "Rules Version",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "model_calls": {
          "const": 0,
          "default": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "critic_run_id",
        "draft_id",
        "draft_hash",
        "independent_input_hash",
        "findings",
        "checkers_completed",
        "duration_ms",
        "limitations"
      ],
      "title": "CriticReportV1",
      "type": "object"
    },
    "ReviewDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "critic_run_id": {
          "format": "uuid",
          "title": "Critic Run Id",
          "type": "string"
        },
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "annotate",
            "targeted_research",
            "block",
            "research_only"
          ],
          "title": "Decision",
          "type": "string"
        },
        "publication_allowed": {
          "title": "Publication Allowed",
          "type": "boolean"
        },
        "verified_finding_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Verified Finding Ids",
          "type": "array"
        },
        "rule_version": {
          "const": "m3-adjudication-v1",
          "default": "m3-adjudication-v1",
          "title": "Rule Version",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "critic_run_id",
        "draft_id",
        "decision",
        "publication_allowed",
        "verified_finding_ids",
        "rationale",
        "decided_at"
      ],
      "title": "ReviewDecisionV1",
      "type": "object"
    },
    "ReviewFindingV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "checker": {
          "enum": [
            "evidence",
            "historical",
            "causal",
            "scenario",
            "temporal_resolution"
          ],
          "title": "Checker",
          "type": "string"
        },
        "code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "verified",
            "pending",
            "refuted"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "affected_fields": {
          "items": {
            "type": "string"
          },
          "title": "Affected Fields",
          "type": "array"
        },
        "recommended_action": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Recommended Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "checker",
        "code",
        "severity",
        "statement",
        "verification_status",
        "affected_fields",
        "recommended_action"
      ],
      "title": "ReviewFindingV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/CriticReportV1"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecisionV1"
    }
  },
  "required": [
    "report",
    "decision"
  ],
  "title": "ReviewViewV1",
  "type": "object"
}
