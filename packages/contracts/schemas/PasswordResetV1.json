{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "email": {
      "maxLength": 254,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9.!#$%&*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
      "title": "Email",
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Password",
      "type": "string"
    },
    "verification_id": {
      "format": "uuid",
      "title": "Verification Id",
      "type": "string"
    },
    "code": {
      "pattern": "^[0-9]{4}$",
      "title": "Code",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password",
    "verification_id",
    "code"
  ],
  "title": "PasswordResetV1",
  "type": "object"
}
