        "publication_allowed": {
          "const": false,
          "default": false,
          "title": "Publication Allowed",
          "type": "boolean"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "draft_hash": {
          "title": "Draft Hash",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "draft_id",
        "label",
        "kind",
        "input_hash",
        "draft_hash"
