    "evidence_snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Snapshot Hash",
      "type": "string"
    },
    "change_reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Change Reason",
      "type": "string"
    }
