  "required": [
    "forecast_version_id",
    "forecast_id",
    "research_run_id",
    "version_num",
    "statement",
    "target",
    "research_as_of",
    "forecast_published_at",
    "evidence_claim_ids",
    "contradiction_claim_ids",
    "mechanism_ids",
    "historical_case_ids",
    "assumptions",
    "falsification_conditions",
    "scenario_ids",
    "next_review_at",
