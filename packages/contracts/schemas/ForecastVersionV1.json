          "type": "string"
        },
        "population_scope": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Population Scope",
          "type": "string"
        },
        "geography": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Geography",
          "type": "string"
        },
        "metric_definition": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "direction_or_threshold": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Direction Or Threshold",
          "type": "string"
        },
        "baseline": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "target_start_at": {
          "format": "date-time",
          "title": "Target Start At",
          "type": "string"
        },
        "target_end_at": {
          "format": "date-time",
