          "type": "string"
        },
        "resolution_source": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Resolution Source",
          "type": "string"
        },
        "resolution_rule": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Resolution Rule",
          "type": "string"
