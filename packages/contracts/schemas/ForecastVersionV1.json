      "type": "array"
    },
    "contradiction_claim_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Contradiction Claim Ids",
      "type": "array"
    },
    "mechanism_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Mechanism Ids",
      "type": "array"
    },
    "historical_case_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Historical Case Ids",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "falsification_conditions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Falsification Conditions",
