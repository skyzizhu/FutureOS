            "format": "uuid",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "affected_fields": {
          "items": {
            "type": "string"
          },
          "title": "Affected Fields",
          "type": "array"
        },
        "recommended_action": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Recommended Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "checker",
        "code",
        "severity",
        "statement",
        "verification_status",
        "affected_fields",
        "recommended_action"
