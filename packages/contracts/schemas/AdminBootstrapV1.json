{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "email": {
      "maxLength": 254,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9.!#$%&*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
      "title": "Email",
      "type": "string"
    },
    "password": {
      "maxLength": 128,
      "minLength": 12,
      "title": "Password",
      "type": "string"
    },
    "bootstrap_token": {
      "maxLength": 128,
      "minLength": 32,
      "title": "Bootstrap Token",
      "type": "string"
    }
  },
  "required": [
    "email",
    "password",
    "bootstrap_token"
  ],
  "title": "AdminBootstrapV1",
  "type": "object"
}
