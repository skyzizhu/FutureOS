{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "default": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "handlers": [
      "default"
    ],
    "level": "INFO"
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    },
    "futureos.requests": {
      "handlers": [
        "default"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
