{
  "name": "futureos", "version": "0.1.0", "private": true,
  "workspaces": ["apps/web", "packages/contracts"],
  "scripts": {
    "contracts": "uv run python -m scripts.export_contracts && node scripts/generate-types.mjs",
    "lint": "eslint apps/web scripts/*.mjs tests/e2e/*.ts",
    "typecheck": "npm run typecheck --workspace @futureos/web",
    "build": "npm run build --workspace @futureos/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0", "eslint": "^9.39.0", "typescript-eslint": "^8.46.0",
    "json-schema-to-typescript": "^15.0.4", "openapi-typescript": "^7.10.0", "@playwright/test": "^1.56.0"
  }
}
