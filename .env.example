# Native deployment: scripts/setup_postgres.py generates an absolute socket URL and .env.
# This sample is for a separately installed PostgreSQL (never a production DB).
DEMO_MODE=true
APP_ENV=development
DATABASE_URL=postgresql+psycopg://futureos_local:change-local-password@127.0.0.1:5432/futureos_m0_demo
TEST_DATABASE_URL=postgresql+psycopg://futureos_local:change-local-password@127.0.0.1:5432/futureos_m0_test
# true only when using the project-local pgserver installation
FUTUREOS_MANAGED_POSTGRES=false
REDIS_URL=redis://127.0.0.1:6381/0
REQUIRE_REDIS=true
FUTUREOS_API_PORT=8100
FUTUREOS_WEB_PORT=3100
API_INTERNAL_URL=http://127.0.0.1:8100
DEMO_USER_TOKEN=demo-user-local-only
DEMO_ADMIN_TOKEN=demo-admin-local-only
DEMO_OTHER_TOKEN=demo-other-local-only
NEXT_TELEMETRY_DISABLED=1

# Server-side Search/Fetch provider. Manual admin requests require an explicit flag.
# Optional server-side credential; never put it in NEXT_PUBLIC_* or commit it.
DEEPSEEK_API_KEY=
LIVE_WEB_ENABLED=false

# M2 internal narrative generation; independent from Search/Fetch. Default remains off.
LIVE_RESEARCH_ENABLED=false
LIVE_CHAT_ENABLED=false
CHAT_MODEL_GLOBAL_WINDOW_LIMIT=60
CHAT_MODEL_GLOBAL_INFLIGHT_LIMIT=8
# DEEPSEEK_RESEARCH_MODEL=

# M4 native local private data; auto-created on first account/profile, never commit the key.
PROFILE_KEY_PATH=.local/private-profile.key
SESSION_HOURS=168

# M5 native scheduler / local-only email transport
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
LIVE_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=futureos@example.invalid
BOUNCE_WEBHOOK_SECRET=

# M6 is off by default. Only enable the local Mock commerce flow intentionally.
SANDBOX_COMMERCE_ENABLED=false
LIVE_PAYMENTS_ENABLED=false
BILLING_PLANS_PATH=infra/billing_plans.json

# M7 bounded local operation; exact host list JSON, no wildcard.
QUEUE_ALERT_SECONDS=600
QUEUE_MAX_PENDING_PER_USER=20
EXPORT_MAX_BYTES=10000000
# FETCH_ALLOWED_HOSTS=["github.com","api.github.com","raw.githubusercontent.com","api-docs.deepseek.com","www.anthropic.com","support.google.com","docs.python.org"]

# Rolling password authentication admission; local BFF shares one source budget.
AUTH_WINDOW_SECONDS=900
AUTH_IDENTITY_ATTEMPTS=10
AUTH_SOURCE_ATTEMPTS=30
AUTH_GLOBAL_ATTEMPTS=60

# Account/admin security. Demo admin token is intentionally off during normal runs.
DEMO_ADMIN_ENABLED=false
ADMIN_SESSION_MINUTES=30
# local_preview never sends mail; smtp requires the TLS SMTP settings above.
AUTH_MAIL_TRANSPORT=local_preview
# Bot protection is off until real site/secret keys and hostname policy are configured.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=["localhost","127.0.0.1"]
